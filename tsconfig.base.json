{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@sigmon/config": ["packages/config/src/index.ts"],
      "@sigmon/db": ["packages/db/src/client.ts"],
      "@sigmon/db/*": ["packages/db/src/*"],
      "@sigmon/queues": ["packages/queues/src/index.ts"],
      "@sigmon/sdk": ["packages/sdk/src/index.ts"],
      "@sigmon/sdk/*": ["packages/sdk/src/*"],
      "@sigmon/telemetry": ["packages/telemetry/src/types.ts"],
      "@sigmon/telemetry/*": ["packages/telemetry/src/*"],
      "@sigmon/worker": ["apps/worker/src/telemetry-worker.ts"]
    }
  }
}
