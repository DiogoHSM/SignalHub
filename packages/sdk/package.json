{
  "name": "@sigmon/sdk",
  "version": "0.2.1",
  "description": "SignalMonitor JavaScript and TypeScript SDK for events, errors, breadcrumbs, traces, LLM calls, identify, Web Vitals, session replay, click maps, feedback widgets, Node CPU/memory profiling, and Next.js instrumentation.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://sigmon.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiogoHSM/sigmon.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/DiogoHSM/sigmon/issues"
  },
  "keywords": [
    "sigmon",
    "signalmonitor",
    "telemetry",
    "observability",
    "analytics",
    "errors",
    "nextjs",
    "sentry",
    "posthog"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "smoke:packed": "node ./scripts/smoke-packed-consumer.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "nanoid": "^5.1.16"
  },
  "devDependencies": {
    "@sigmon/telemetry": "workspace:*",
    "vitest": "^3.2.7"
  }
}
