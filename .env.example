NODE_ENV=development
WORKER_ROLE=all
PORT=3000
DATABASE_URL=postgres://sigmon:sigmon-local-only-change-me@localhost:5432/sigmon
REDIS_URL=redis://localhost:6379
POSTGRES_PASSWORD=sigmon-local-only-change-me
POSTGRES_PASSWORD_URLENCODED=
POSTGRES_PORT=5432
REDIS_PORT=6379
SESSION_SECRET=change-me-to-a-long-random-secret
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_PREVIOUS=
LOGIN_SOURCE_MAX_ATTEMPTS=10
LOGIN_SOURCE_WINDOW_MS=60000
LOGIN_ACCOUNT_MAX_ATTEMPTS=8
LOGIN_ACCOUNT_WINDOW_MS=900000
LOGIN_ARGON2_CONCURRENCY=4
LOGIN_PROGRESSIVE_DELAY_MAX_MS=2000
API_KEY_PEPPER=change-me-to-a-long-random-pepper
CONSOLE_ENABLED=true
SIGMON_PUBLIC_ENDPOINT=http://localhost:3000
# Keep false unless raw telemetry detail must be sent to a trusted MCP client. Raw detail may be disclosed to an external AI provider.
MCP_ALLOW_RAW_DETAIL=false
# Hostnames that receive the public landing page at / instead of the console redirect
LANDING_HOSTS=sigmon.app,www.sigmon.app
BROWSER_CORS_ORIGINS=
# Comma-separated literal reverse-proxy IPs or CIDRs. Leave empty unless requests arrive through those exact proxies.
TRUSTED_PROXY_CIDRS=
# Comma-separated RFC1918/ULA CIDRs permitted for outbound integrations. Public destinations need no entry.
OUTBOUND_PRIVATE_CIDRS=
# Development-only opt-in for localhost/loopback outbound integrations. Production rejects true.
ALLOW_LOOPBACK_OUTBOUND=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password-32-chars-min
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
RETENTION_ENABLED=true
RETENTION_INTERVAL_MINUTES=60
RETENTION_BATCH_SIZE=1000
RETENTION_EVENTS_DAYS=90
RETENTION_ERRORS_DAYS=180
RETENTION_TRACES_DAYS=90
RETENTION_SPANS_DAYS=90
RETENTION_LLM_CALLS_DAYS=180
RETENTION_BREADCRUMBS_DAYS=30
RETENTION_DEAD_LETTER_JOBS_DAYS=30
EVENT_ROLLUPS_ENABLED=true
EVENT_ROLLUPS_INTERVAL_MINUTES=60
EVENT_ROLLUPS_LOOKBACK_DAYS=400
WAREHOUSE_EXPORTS_ENABLED=true
WAREHOUSE_EXPORTS_INTERVAL_MINUTES=15
WAREHOUSE_CONNECTION_TIMEOUT_MS=5000
WAREHOUSE_STATEMENT_TIMEOUT_MS=30000
WAREHOUSE_LOCK_TIMEOUT_MS=5000
WAREHOUSE_QUERY_TIMEOUT_MS=35000
WAREHOUSE_TOTAL_TIMEOUT_MS=60000
ALERTS_ENABLED=true
ALERTS_INTERVAL_MINUTES=1
ALERTS_WEBHOOK_TIMEOUT_MS=5000
MONITORS_ENABLED=true
MONITORS_INTERVAL_MINUTES=1
MONITORS_HTTP_TIMEOUT_MS=5000
MONITORS_MAX_CONCURRENCY=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
BACKUPS_ENABLED=true
BACKUPS_INTERVAL_HOURS=24
BACKUPS_LOCAL_DIR=/var/lib/sigmon/backups
BACKUPS_RETENTION_DAYS=14
BACKUPS_S3_ENABLED=false
BACKUPS_S3_ENDPOINT=
BACKUPS_S3_REGION=auto
BACKUPS_S3_BUCKET=
BACKUPS_S3_ACCESS_KEY_ID=
BACKUPS_S3_SECRET_ACCESS_KEY=
BACKUPS_S3_PREFIX=sigmon
SOURCE_MAPS_LOCAL_DIR=/var/lib/sigmon/source-maps
SOURCE_MAPS_MAX_UPLOAD_MB=50
SOURCE_MAPS_RETENTION_ENABLED=true
SOURCE_MAPS_RETENTION_DAYS=180
SOURCE_MAPS_RETENTION_BATCH_SIZE=100
SYSTEM_HEALTH_HISTORY_ENABLED=true
SYSTEM_HEALTH_SAMPLE_INTERVAL_MINUTES=5
SYSTEM_HEALTH_HISTORY_RETENTION_HOURS=48
DB_STATEMENT_TIMEOUT_MS=15000
DB_WORKER_STATEMENT_TIMEOUT_MS=0
FUNNEL_MAX_ACTORS=50000
