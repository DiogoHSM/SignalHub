    "@sigmon/telemetry": "workspace:*",
    "@smithy/node-http-handler": "^4.11.3",
    "bullmq": "^5.76.4",
    "ioredis": "^5.10.1",
    "kysely": "^0.28.17",
    "nodemailer": "^9.1.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
