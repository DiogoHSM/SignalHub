{
  "name": "sigmon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "dev:console": "pnpm --filter @sigmon/console dev",
    "build:console": "pnpm --filter @sigmon/console build",
    "dev:api": "pnpm --filter @sigmon/api dev",
    "dev:worker": "pnpm --filter @sigmon/worker dev",
    "start:api": "pnpm --filter @sigmon/api start",
    "start:worker": "pnpm --filter @sigmon/worker start",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "source-maps:upload": "tsx packages/cli/src/index.ts sourcemaps upload",
    "source-maps:reconcile": "tsx scripts/reconcile-source-maps.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "secrets:migrate": "tsx scripts/migrate-integration-secrets.ts",
    "backup:create": "tsx scripts/backup-create.ts",
    "backup:restore": "tsx scripts/backup-restore.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "doctor": "tsx scripts/doctor.ts",
    "privacy:redact-feedback-urls": "tsx scripts/redact-feedback-urls.ts",
    "smoke:compose": "tsx scripts/smoke-compose.ts",
    "smoke:sdk-packed": "pnpm --filter @sigmon/sdk smoke:packed"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "jsdom": "^26.1.0",
    "testcontainers": "^12.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "yaml": "2.8.3"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/session": "^11.1.2",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@sigmon/config": "workspace:*",
    "argon2": "^0.44.0",
    "bullmq": "^5.76.4",
    "fastify": "^5.12.1",
    "fflate": "^0.8.3",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "kysely": "^0.28.17",
    "nanoid": "^5.1.16",
    "nodemailer": "^9.1.1",
    "pg": "^8.20.0",
    "zod": "^4.4.2"
  }
}
